# ==============================================
# DESD-API-Rest — Variables de entorno (.env)
# Copia este archivo como .env y ajusta secretos en producción
# ==============================================

# Puerto público de la API (usa 5001 en macOS si AirPlay ocupa el 5000)
API_PORT=5000

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=desd

# RabbitMQ
RABBITMQ_USER=user
RABBITMQ_PASS=password
RABBITMQ_DLX=desd.dlx
RABBITMQ_PREFETCH=8

# Seguridad JWT (CAMBIAR en producción: openssl rand -hex 32)
JWT_SECRET_KEY=CAMBIAR_EN_PRODUCCION_CON_OPENSSL_RAND_HEX_32

# Conversión (MuPDF / Poppler / libvips)
CONVERTER_DPI=150
CONVERTER_MAX_DIM=960
CONVERTER_JPEG_QUALITY=85
CONVERTER_FAST_PDFIMAGES=1
CONVERTER_PDF_CHUNK_SIZE=8
INGEST_CONCURRENCY=4

# Worker IA
WORKER_QUEUE_NAME=queue_worker
ENABLED_MODELS=cude,rode,legibility,tilde
WORKER_PREFETCH_THREADS=2
WORKER_DB_BATCH_SIZE=8
WORKER_DB_FLUSH_WINDOW_MS=15

# Duplicados
DUPLICATE_QUEUE_NAME=queue_dude
DUPLICATE_SSIM_MAX_DIM=512

# Hot-Folder local integrado en la API
HOTFOLDER_ENABLED=true
HOTFOLDER_POLL_INTERVAL=0.5
HOTFOLDER_DEFAULT_USER=admin
